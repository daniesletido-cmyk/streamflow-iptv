{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)\\.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"StreamFlow-AntiRevoke.mobileconfig\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
